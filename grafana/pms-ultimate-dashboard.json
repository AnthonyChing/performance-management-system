{
  "title": "PMS Ultimate SRE Dashboard (Bulletproof)",
  "uid": "pms-dashboard-bulletproof",
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "🌟 Row 1: Four Golden Signals (Executive View)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "1. Traffic (RPS)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\", application=~\"$application\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "2. Latency (Avg)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate({__name__=~\"http_server_requests_milliseconds_bucket|http_server_requests_milliseconds_bucket\", application=~\"$application\"}[2m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "3. Errors (5xx Rate %)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\", application=~\"$application\", status=~\"5..\"}[2m])) / sum(rate({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\", application=~\"$application\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "4. Saturation (DB Pending Conn)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_pending{application=~\"$application\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "🔴 Row 2: RED Method (API View)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Rate (Requests/sec per API)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\", application=~\"$application\"}[2m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors (Failed req/sec)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\", application=~\"$application\", status=~\"4..|5..\"}[2m])) by (uri, status)",
          "legendFormat": "{{status}} - {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duration (Avg Latency per API)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate({__name__=~\"http_server_requests_milliseconds_bucket|http_server_requests_milliseconds_bucket\", application=~\"$application\"}[2m])) by (le, uri))",
          "legendFormat": "P95 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "💻 Row 3: USE Method (Infra View)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Utilization (CPU / Memory)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "avg(process_cpu_usage{application=~\"$application\"})",
          "legendFormat": "CPU Usage (avg)",
          "refId": "A"
        },
        {
          "expr": "avg({__name__=~\"jvm_memory_used|jvm_memory_used_bytes\", application=~\"$application\"} / {__name__=~\"jvm_memory_max|jvm_memory_max_bytes\", application=~\"$application\"})",
          "legendFormat": "JVM Memory Usage (avg)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Saturation (Queue/Pending)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_pending{application=~\"$application\"})",
          "legendFormat": "DB Threads Pending",
          "refId": "A"
        },
        {
          "expr": "sum(tomcat_threads_busy{application=~\"$application\"})",
          "legendFormat": "Tomcat Threads Busy",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "hide": 0,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "hide": 0,
        "includeAll": true,
        "name": "application",
        "query": "label_values({__name__=~\"http_server_requests_milliseconds_count|http_server_requests_milliseconds_count\"}, application)",
        "type": "query"
      }
    ]
  }
}