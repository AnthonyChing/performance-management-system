# Copy this to `.env` (project root) and fill in real values.
# `.env` is git-ignored — never commit it.
#
# Used by docker-compose.yml when running `docker compose up backend`.

# Required: HMAC secret for signing JWTs. Use any random string >= 32 bytes.
# `docker compose up` will refuse to start if this is unset.
JWT_SECRET=replace-with-your-own-local-dev-secret-at-least-32-bytes-long

# Optional overrides — defaults are sensible for local dev.
SPRING_PROFILES_ACTIVE=dev
GRAFANA_OTLP_URL=http://localhost:4318
GOOGLE_CLIENT_ID=
